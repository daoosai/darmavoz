darmavoz.ru {
  handle_path /s3/* {
    reverse_proxy minio:9000
  }

  handle_path /static/* {
    root * /srv/darmavoz/static
    file_server
  }

  @api path /api/* /health /ping
  handle @api {
    reverse_proxy darmavoz_backend:8000
  }

  handle {
    root * /opt/darmavoz/frontend/dist
    try_files {path} /index.html
    file_server
  }
}
