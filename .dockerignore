# Git and CI metadata
.git
.github

# Python caches
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# Local environments
.venv
venv

# Frontend dependencies and build artifacts
node_modules
frontend/node_modules
frontend/dist
react_web/node_modules
react_web/dist

# Mobile / local build artifacts
mobile/.dart_tool
mobile/build

# Logs
*.log

# Secrets must never be sent to the Docker build context.
*firebase*.json
*.keystore
keystore_base64.txt

# Server credentials are injected at runtime, never baked into images.
.env
.env.*
**/.env
**/.env.*

# Downloadable releases, reports and native projects are not backend inputs.
backend/
**/*.apk
**/*.aab
docs/reports/
frontend/android/
frontend/ios/
