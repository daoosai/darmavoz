darmavoz.ru {
  handle_path /s3/* {
    reverse_proxy minio:9000
  }

  @rootFlutterAssets path /flutter_bootstrap.js /flutter.js /main.dart.js /manifest.json /favicon.png /version.json /flutter_service_worker.js /assets/* /icons/* /canvaskit/*
  handle @rootFlutterAssets {
    root * /srv/darmavoz/web
    file_server
  }

  handle_path /static/* {
    root * /srv/darmavoz/static
    file_server
  }

  handle_path /app* {
    root * /srv/darmavoz/web
    try_files {path} /index.html
    file_server
  }

  reverse_proxy darmavoz_backend:8000
}
